+        XCTAssertTrue(editNotification.otpValidationRequired())
+        XCTAssertTrue(editNotification.expirationRequired())
+        guard case .carbsEdit(let action) = editNotification.toRemoteAction() else {
+            return XCTFail("Expected carbsEdit action")
+        }
+        XCTAssertEqual(action.syncIdentifier, syncIdentifier)
+        XCTAssertEqual(action.amountInGrams, 22.0)
+        XCTAssertEqual(action.absorptionTime, TimeInterval(hours: 3.0))
+        XCTAssertEqual(action.startDate, dateFormatter().date(from: startDateString))
+    }
