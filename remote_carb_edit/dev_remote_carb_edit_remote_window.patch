+//
+//  CarbEditRemoteNotification.swift
+//  NightscoutServiceKit
+//
+
+import Foundation
+import LoopKit
+
+/// Replacement values use prefixed keys so an unpatched Loop never reads them as a new carb entry.
+public struct CarbEditRemoteNotification: RemoteNotification, Codable {
+
+    public let syncIdentifier: String
+    public let amount: Double
+    public let absorptionInHours: Double
+    public let foodType: String?
+    public let startDate: Date
+    public let remoteAddress: String
+    public let expiration: Date?
+    public let sentAt: Date
+    public let otp: String?
+    public let enteredBy: String?
+    public let encryptedReturnNotification: String?
+
+    enum CodingKeys: String, CodingKey {
+        case syncIdentifier = "carbs-edit"
+        case amount = "carbs-edit-entry"
+        case absorptionInHours = "carbs-edit-absorption-time"
+        case foodType = "carbs-edit-food-type"
+        case startDate = "carbs-edit-start-time"
+        case remoteAddress = "remote-address"
+        case expiration = "expiration"
+        case sentAt = "sent-at"
+        case otp = "otp"
+        case enteredBy = "entered-by"
+        case encryptedReturnNotification = "encrypted_return_notification"
+    }
+
+    public func absorptionTime() -> TimeInterval {
+        return TimeInterval(hours: absorptionInHours)
+    }
+
+    func toRemoteAction() -> Action {
+        let action = CarbEditAction(syncIdentifier: syncIdentifier, amountInGrams: amount, absorptionTime: absorptionTime(), foodType: foodType, startDate: startDate)
+        return .carbsEdit(action)
+    }
+
+    func otpValidationRequired() -> Bool {
+        return true
+    }
+
+    func expirationRequired() -> Bool {
+        return true
+    }
+
+    public static func includedInNotification(_ notification: [String: Any]) -> Bool {
+        return notification["carbs-edit"] != nil
+    }
+}
