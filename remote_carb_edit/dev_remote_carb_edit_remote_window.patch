+    func replaceCarbs(syncIdentifier: String, amountInGrams: Double, absorptionTime: TimeInterval, foodType: String?, startDate: Date) async throws -> StoredCarbEntry {
+        let existing = try await remoteEditableCarbEntry(syncIdentifier: syncIdentifier)
+        try validateRemoteCarbParameters(amountInGrams: amountInGrams, absorptionTime: absorptionTime, startDate: startDate)
+
+        let quantity = HKQuantity(unit: .gram(), doubleValue: amountInGrams)
+        let replacement = NewCarbEntry(quantity: quantity, startDate: startDate, foodType: foodType ?? existing.foodType, absorptionTime: absorptionTime)
+
+        return try await withCheckedThrowingContinuation { continuation in
+            addCarbEntry(replacement, replacing: existing) { result in
+                switch result {
+                case .success(let storedCarbEntry):
