+        do {
+            guard let servicesManagerDelegate else {
+                throw CarbActionError.internalError
+            }
+            let replacement = try await servicesManagerDelegate.replaceCarbs(syncIdentifier: syncIdentifier, amountInGrams: amountInGrams, absorptionTime: absorptionTime, foodType: foodType, startDate: startDate)
+            await NotificationManager.sendRemoteCarbChangeNotification(body: body)
+            await remoteDataServicesManager.triggerUpload(for: .carb)
+            return replacement
+        } catch {
+            await NotificationManager.sendRemoteCarbChangeFailureNotification(body: body, error: error)
+            throw error
+        }
+    }
