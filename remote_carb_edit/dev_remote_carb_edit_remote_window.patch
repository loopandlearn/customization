+        ]
+
+        let remoteNotification = try notification.toRemoteNotification()
+
+        let editNotification = try XCTUnwrap(remoteNotification as? CarbEditRemoteNotification)
+        XCTAssertEqual(editNotification.syncIdentifier, syncIdentifier)
+        XCTAssertEqual(editNotification.amount, 22.0)
+        XCTAssertEqual(editNotification.absorptionTime(), TimeInterval(hours: 3.0))
