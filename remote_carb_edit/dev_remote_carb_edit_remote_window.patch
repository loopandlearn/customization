+//
+//  RemoteNotificationCapabilitiesTestCase.swift
+//  NightscoutServiceKitTests
+//
+
+import XCTest
+@testable import NightscoutServiceKit
+
+final class RemoteNotificationCapabilitiesTestCase: XCTestCase {
+
+    func testSupportedCommands_MatchNotificationKeys() {
+        XCTAssertEqual(RemoteNotificationCapabilities.supported, ["carbs-delete", "carbs-edit"])
+        XCTAssertTrue(CarbDeleteRemoteNotification.includedInNotification(["carbs-delete": "id"]))
+        XCTAssertTrue(CarbEditRemoteNotification.includedInNotification(["carbs-edit": "id"]))
+        for key in RemoteNotificationCapabilities.supported {
+            let notification: [String: Any] = [key: "id"]
+            XCTAssertTrue(CarbDeleteRemoteNotification.includedInNotification(notification)
+                          || CarbEditRemoteNotification.includedInNotification(notification), key)
+        }
+    }
+}
