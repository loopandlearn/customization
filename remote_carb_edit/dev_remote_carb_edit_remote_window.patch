@@ -0,0 +1,61 @@
+//
+//  CarbDeleteRemoteNotificationTestCase.swift
+//  NightscoutServiceKitTests
+//
+
+import XCTest
+@testable import NightscoutServiceKit
+
+final class CarbDeleteRemoteNotificationTestCase: XCTestCase {
+
+    func testParseCarbDeleteNotification_ValidPayload_Succeeds() throws {
+        let syncIdentifier = "3F2504E0-4F89-11D3-9A0C-0305E82C3301"
+        let notification: [String: AnyObject] = [
+            "remote-address": "::ffff:11.2.44.155" as AnyObject,
+            "sent-at": "2023-02-25T20:46:35.778Z" as AnyObject,
+            "expiration": "2023-02-25T20:51:35.778Z" as AnyObject,
+            "carbs-delete": syncIdentifier as AnyObject,
+            "otp": "12345" as AnyObject
+        ]
+
+        let remoteNotification = try notification.toRemoteNotification()
+
+        let deleteNotification = try XCTUnwrap(remoteNotification as? CarbDeleteRemoteNotification)
+        XCTAssertEqual(deleteNotification.syncIdentifier, syncIdentifier)
+        XCTAssertEqual(deleteNotification.otp, "12345")
+        XCTAssertTrue(deleteNotification.otpValidationRequired())
+        XCTAssertTrue(deleteNotification.expirationRequired())
+        guard case .carbsDelete(let action) = deleteNotification.toRemoteAction() else {
+            return XCTFail("Expected carbsDelete action")
+        }
+        XCTAssertEqual(action.syncIdentifier, syncIdentifier)
+    }
+
+    func testValidate_MissingExpiration_Throws() throws {
+        let notification: [String: AnyObject] = [
+            "remote-address": "::ffff:11.2.44.155" as AnyObject,
+            "sent-at": "2023-02-25T20:46:35.778Z" as AnyObject,
+            "carbs-delete": "abc" as AnyObject,
+            "otp": "12345" as AnyObject
+        ]
+        let remoteNotification = try notification.toRemoteNotification()
+        let validator = RemoteCommandValidator(otpManager: OTPTestCoordinator().createOTPManager())
+
+        XCTAssertThrowsError(try validator.validate(remoteNotification: remoteNotification)) { error in
+            guard case RemoteCommandValidator.NotificationValidationError.missingExpiration = error else {
+                return XCTFail("Unexpected error \(error)")
+            }
+        }
+    }
+
+    func testParseCarbDeleteNotification_MissingSentAt_Throws() throws {
+        let notification: [String: AnyObject] = [
+            "remote-address": "::ffff:11.2.44.155" as AnyObject,
+            "expiration": "2099-02-25T20:51:35.778Z" as AnyObject,
+            "carbs-delete": "abc" as AnyObject,
+            "otp": "12345" as AnyObject
+        ]
+
+        XCTAssertThrowsError(try notification.toRemoteNotification())
+    }
+}
