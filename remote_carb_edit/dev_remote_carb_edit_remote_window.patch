+    func deleteRemoteCarbs(syncIdentifier: String) async throws -> StoredCarbEntry {
+        do {
+            guard let servicesManagerDelegate else {
+                throw CarbActionError.internalError
+            }
+            let deleted = try await servicesManagerDelegate.deleteCarbs(syncIdentifier: syncIdentifier)
+            let body = String(format: NSLocalizedString("Remote Carbs Delete: %d grams removed", comment: "The notification body for a successful remote carb delete. (1: Carb amount in grams)"), Int(deleted.quantity.doubleValue(for: .gram())))
+            await NotificationManager.sendRemoteCarbChangeNotification(body: body)
+            await remoteDataServicesManager.triggerUpload(for: .carb)
+            return deleted
+        } catch {
+            let body = NSLocalizedString("Remote Carbs Delete", comment: "The notification body prefix for a failed remote carb delete")
