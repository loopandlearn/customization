@@ -0,0 +1,71 @@
+//
+//  ProfileSwitchRemoteNotificationTestCase.swift
+//  NightscoutServiceKitTests
+//
+
+import XCTest
+import LoopKit
+import NightscoutKit
+@testable import NightscoutServiceKit
+
+final class ProfileSwitchRemoteNotificationTestCase: XCTestCase {
+
+    func testParseProfileSwitchNotification_ValidPayload_Succeeds() throws {
+        let notification: [String: Any] = [
+            "profile-switch": "Sport",
+            "profile-switch-fingerprint": "fec4f066b5a54ecd",
+            "remote-address": "LoopFollow",
+            "sent-at": "2023-02-25T20:46:35.778Z",
+            "expiration": "2023-02-25T20:51:35.778Z",
+            "otp": "123456"
+        ]
+
+        XCTAssertTrue(ProfileSwitchRemoteNotification.includedInNotification(notification))
+        let profileSwitch = try ProfileSwitchRemoteNotification(dictionary: notification)
+
+        XCTAssertEqual(profileSwitch.profileName, "Sport")
+        XCTAssertEqual(profileSwitch.fingerprint, "fec4f066b5a54ecd")
+        XCTAssertEqual(profileSwitch.expiration, ISO8601DateFormatter.fractional.date(from: "2023-02-25T20:51:35.778Z"))
+        XCTAssertTrue(profileSwitch.otpValidationRequired())
+        guard case .profileSwitch(let action) = profileSwitch.toRemoteAction() else {
+            return XCTFail("Expected a profile switch action")
+        }
+        XCTAssertEqual(action.name, "Sport")
+    }
+
+    func testParseProfileSwitchNotification_MissingExpiration_Fails() {
+        let notification: [String: Any] = [
+            "profile-switch": "Sport",
+            "profile-switch-fingerprint": "fec4f066b5a54ecd",
+            "remote-address": "LoopFollow",
+            "otp": "123456"
+        ]
+
+        XCTAssertThrowsError(try ProfileSwitchRemoteNotification(dictionary: notification))
+    }
+
+    func testFingerprint_MatchesFollowerVector() {
+        func items(_ values: [(TimeInterval, Double)]) -> [ProfileSet.ScheduleItem] {
+            values.map { ProfileSet.ScheduleItem(offset: $0.0, value: $0.1) }
+        }
+        let profile = ProfileSet.Profile(
+            timezone: TimeZone(secondsFromGMT: 3600)!,
+            dia: .hours(6),
+            sensitivity: items([(0, 45)]),
+            carbratio: items([(0, 10)]),
+            basal: items([(0, 0.85), (21600, 1.1)]),
+            targetLow: items([(0, 100)]),
+            targetHigh: items([(0, 110)]),
+            units: "mg/dL")
+
+        XCTAssertEqual(profile.remoteFingerprint, "fec4f066b5a54ecd")
+    }
+}
+
+private extension ISO8601DateFormatter {
+    static let fractional: ISO8601DateFormatter = {
+        let formatter = ISO8601DateFormatter()
+        formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return formatter
+    }()
+}
