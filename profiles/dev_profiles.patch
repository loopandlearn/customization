+// MARK: - Profiles saved as files
+
+@MainActor
+extension DeviceDataManager {
+    /// A profile saved by the earlier Profiles customization as `Documents/LoopProfile/*.json`.
+    private struct FileTherapyProfile: Decodable {
+        let name: String
+        let correctionRange: GlucoseRangeSchedule
+        let carbRatioSchedule: CarbRatioSchedule
+        let basalRateSchedule: BasalRateSchedule
+        let insulinSensitivitySchedule: InsulinSensitivitySchedule
+        let sortOrder: Int?
+    }
+
+    private static let fileTherapyProfileActiveNameKey = "currentProfileName"
+    private static let fileTherapyProfileLeftOutKey = "com.loopkit.Loop.TherapyProfileFilesLeftOut"
+
+    private static var fileTherapyProfileDirectory: URL {
+        FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0].appendingPathComponent("LoopProfile")
+    }
+
+    /// Moves profiles saved as files by the earlier Profiles customization into the stored settings. The files of
+    /// imported profiles are deleted once settings holding every imported profile are stored; until then each call
+    /// imports what is missing. Names are changed to pass the name rules. A profile beyond the profile limit or with a
+    /// name that can not be used is named in one alert and not tried again; its file, and any file that can not be
+    /// read, is kept in `LoopProfile/NotMoved`. The saved active profile stays active only when its values equal the
+    /// live settings; otherwise the active profile is unchanged.
+    func importFileTherapyProfilesIfNeeded(defaults: UserDefaults = .standard) {
+        let directory = Self.fileTherapyProfileDirectory
+        guard FileManager.default.fileExists(atPath: directory.path) else {
+            return
+        }
+        let files = ((try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil)) ?? [])
+            .filter { $0.pathExtension == "json" }
+            .sorted { $0.lastPathComponent < $1.lastPathComponent }
+
+        guard !files.isEmpty else {
+            return
+        }
+
+        var savedFiles: [(url: URL, profile: FileTherapyProfile)] = []
+        var unreadable: [URL] = []
+        for file in files {
+            do {
+                savedFiles.append((file, try JSONDecoder().decode(FileTherapyProfile.self, from: Data(contentsOf: file))))
+            } catch {
+                unreadable.append(file)
+                log.error("Profile file %{public}@ not imported: %{public}@", file.lastPathComponent, String(describing: error))
+            }
+        }
+        savedFiles.sort { ($0.profile.sortOrder ?? 0) < ($1.profile.sortOrder ?? 0) }
+        let saved = savedFiles.map(\.profile)
+
+        let names = Self.importNames(for: saved.map(\.name))
+        let storedNames = Set((settingsManager.settingsStore.latestSettings?.therapyProfiles ?? []).map { $0.name.lowercased() })
+        let leftOut = Set(defaults.stringArray(forKey: Self.fileTherapyProfileLeftOutKey) ?? [])
+        if names.allSatisfy({ storedNames.contains($0.lowercased()) || leftOut.contains($0) }) {
+            let notMoved = directory.appendingPathComponent("NotMoved")
+            do {
+                for (file, name) in zip(savedFiles.map(\.url), names) where !leftOut.contains(name) {
+                    try FileManager.default.removeItem(at: file)
+                }
+                let kept = zip(savedFiles.map(\.url), names).filter { leftOut.contains($0.1) }.map(\.0) + unreadable
+                if !kept.isEmpty {
+                    try FileManager.default.createDirectory(at: notMoved, withIntermediateDirectories: true)
+                    for file in kept {
+                        try FileManager.default.moveItem(at: file, to: notMoved.appendingPathComponent(file.lastPathComponent))
+                    }
+                }
+                defaults.removeObject(forKey: Self.fileTherapyProfileActiveNameKey)
+                defaults.removeObject(forKey: Self.fileTherapyProfileLeftOutKey)
+                log.default("Profiles saved as files are stored in the settings; %d files are deleted, %d kept in NotMoved", files.count - kept.count, kept.count)
+            } catch {
+                log.error("Profile files not settled: %{public}@", String(describing: error))
+            }
+            return
+        }
+
+        guard let live = therapyProfileSettings.liveTherapyProfile else {
+            log.default("Profiles saved as files wait for therapy settings before import")
+            return
+        }
+
+        var profiles = TherapyProfiles.resolved(therapyProfileSettings.therapyProfiles, activeProfileName: therapyProfileSettings.activeProfileName, live: live)
+        var imported: [String] = []
+        var newlyLeftOut: [String] = []
+        for (file, name) in zip(saved, names) {
+            let profile = TherapyProfile(name: name,
+                                         glucoseTargetRangeSchedule: file.correctionRange,
+                                         carbRatioSchedule: file.carbRatioSchedule,
+                                         basalRateSchedule: file.basalRateSchedule,
+                                         insulinSensitivitySchedule: file.insulinSensitivitySchedule)
+            guard !profiles.contains(where: { $0.name.lowercased() == profile.name.lowercased() }), !leftOut.contains(name) else {
+                continue
+            }
+            guard profiles.count < TherapyProfileValidator.maximumProfileCount else {
+                log.error("Profile file %{public}@ not imported: Loop keeps at most %d profiles", profile.name, TherapyProfileValidator.maximumProfileCount)
+                newlyLeftOut.append(name)
+                continue
+            }
+            do {
+                _ = try TherapyProfileValidator.validateName(profile.name, isDefault: false, existingNames: profiles.map(\.name))
+                profiles.append(profile)
+                imported.append(profile.name)
+            } catch {
+                log.error("Profile file %{public}@ not imported: %{public}@", profile.name, error.localizedDescription)
+                newlyLeftOut.append(name)
+            }
+        }
+        if !newlyLeftOut.isEmpty {
+            defaults.set(Array(leftOut) + newlyLeftOut, forKey: Self.fileTherapyProfileLeftOutKey)
+            let body = String(format: "These profiles saved by the earlier version of Profiles were not moved into Loop's settings, because Loop keeps at most %1$d profiles or the name can not be used. Their files are kept on this phone, in Loop's LoopProfile/NotMoved folder:\n\n%2$@", TherapyProfileValidator.maximumProfileCount, newlyLeftOut.joined(separator: "\n"))
+            let content = Alert.Content(title: "Profiles Not Moved", body: body, acknowledgeActionButtonLabel: "OK")
+            therapyProfileAlertIssuer?.issueAlert(Alert(identifier: Alert.Identifier(managerIdentifier: "TherapyProfiles", alertIdentifier: "fileImport"),
+                                     foregroundContent: content,
+                                     backgroundContent: content,
+                                     trigger: .immediate))
+        }
+        guard !imported.isEmpty else {
+            return
+        }
+
+        var activeProfileName = therapyProfileSettings.activeProfileName
+        if activeProfileName == nil,
+           let currentName = defaults.string(forKey: Self.fileTherapyProfileActiveNameKey),
+           let index = saved.firstIndex(where: { $0.name == currentName }),
+           imported.contains(names[index]),
+           let current = profiles.first(where: { $0.name == names[index] }),
+           current.hasSameValues(as: live)
+        {
+            activeProfileName = current.name
+        }
+
+        log.default("Importing %d profiles saved as files, active: %{public}@", imported.count, TherapyProfiles.activeName(activeProfileName))
+        mutateTherapyProfileSettings { settings in
+            settings.therapyProfiles = profiles
+            settings.activeProfileName = activeProfileName
+        }
+    }
+
+    /// Names that pass the name rules: trimmed, at most 32 characters, no "." or leading "$", not Default, and unique.
+    private static func importNames(for fileNames: [String]) -> [String] {
+        var names: [String] = []
+        for fileName in fileNames {
+            var name = fileName.trimmingCharacters(in: .whitespacesAndNewlines).replacingOccurrences(of: ".", with: ",")
+            while name.hasPrefix("$") {
+                name.removeFirst()
+            }
+            if name.isEmpty || name.caseInsensitiveCompare(TherapyProfile.defaultName) == .orderedSame {
+                name = "Saved " + (name.isEmpty ? "profile" : name)
+            }
+            name = String(name.prefix(28)).trimmingCharacters(in: .whitespaces)
+            var unique = name
+            var number = 2
+            while names.contains(where: { $0.caseInsensitiveCompare(unique) == .orderedSame }) {
+                unique = "\(name) \(number)"
+                number += 1
+            }
+            names.append(unique)
+        }
+        return names
+    }
+}
