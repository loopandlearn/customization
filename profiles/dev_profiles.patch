@@ -0,0 +1,1156 @@
+//
+//  NightscoutService+TherapyProfiles.swift
+//  NightscoutServiceKit
+//
+//  Therapy profiles in the Nightscout profile document, Profile Switch treatments, the import of every profile, and
+//  the remote profile commands. The document fields are written as raw JSON, so the NightscoutKit version the
+//  workspace pins is enough.
+//
+
+import CryptoKit
+import Foundation
+import HealthKit
+import LoopKit
+import NightscoutKit
+import OSLog
+
+// MARK: - Profile document
+
+/// A profile set with the therapy profile fields.
+struct TherapyProfileSet {
+    let profileSet: ProfileSet
+    let profileEditLimits: ProfileEditLimits?
+    let remoteCommands: [String]?
+    let scheduledSwitches: [ScheduledSwitch]?
+    let scheduledSwitchesFingerprint: String?
+
+    var startDate: Date { profileSet.startDate }
+    var defaultProfile: String { profileSet.defaultProfile }
+    var store: ProfileSet.ProfileStore { profileSet.store }
+    var syncIdentifier: String { profileSet.syncIdentifier }
+
+    var dictionaryRepresentation: [String: Any] {
+        var rval = profileSet.dictionaryRepresentation
+        rval["profileEditLimits"] = profileEditLimits?.dictionaryRepresentation
+        rval["remoteCommands"] = remoteCommands
+        rval["scheduledSwitches"] = scheduledSwitches?.map(\.dictionaryRepresentation)
+        rval["scheduledSwitchesFingerprint"] = scheduledSwitchesFingerprint
+        return rval
+    }
+
+    /// A weekly start of the store profile named `profile`, `time` seconds after midnight in the profiles' time zone
+    /// on `weekday` (1–7, Sunday = 1). It stays active until the next start.
+    struct ScheduledSwitch: Equatable {
+        let id: String
+        let profile: String
+        let weekday: Int
+        let time: Int
+        /// A paused start does not run.
+        let paused: Bool
+
+        var dictionaryRepresentation: [String: Any] {
+            var rval: [String: Any] = [
+                "id": id,
+                "profile": profile,
+                "weekday": weekday,
+                "time": time,
+            ]
+            if paused {
+                rval["paused"] = true
+            }
+            return rval
+        }
+
+        init(id: String, profile: String, weekday: Int, time: Int, paused: Bool = false) {
+            self.id = id
+            self.profile = profile
+            self.weekday = weekday
+            self.time = time
+            self.paused = paused
+        }
+
+        init?(rawValue: [String: Any]) {
+            guard
+                let id = rawValue["id"] as? String,
+                let profile = rawValue["profile"] as? String,
+                let weekday = rawValue["weekday"] as? Int,
+                let time = rawValue["time"] as? Int
+            else {
+                return nil
+            }
+            self.init(id: id, profile: profile, weekday: weekday, time: time, paused: rawValue["paused"] as? Bool ?? false)
+        }
+    }
+}
+
+/// The bounds a remote editor of a profile set's profiles must keep to. Glucose limits and steps are in `units`.
+struct ProfileEditLimits: Equatable {
+    struct ValueLimits: Equatable {
+        let min: Double
+        let max: Double
+        let step: Double
+        /// Bounds outside which the uploader warns, when it has any.
+        let recommendedMin: Double?
+        let recommendedMax: Double?
+
+        var dictionaryRepresentation: [String: Any] {
+            var rval: [String: Any] = [
+                "min": min,
+                "max": max,
+                "step": step,
+            ]
+            rval["recommendedMin"] = recommendedMin
+            rval["recommendedMax"] = recommendedMax
+            return rval
+        }
+    }
+
+    let units: String
+    let maxBasal: Double
+    /// The basal rates the pump supports, up to `maxBasal`.
+    let basalRates: [Double]
+    /// The most basal rate entries the pump can store, when it has a limit.
+    let maxBasalSegments: Int?
+    let carbRatio: ValueLimits
+    let sensitivity: ValueLimits
+    let target: ValueLimits
+    /// The most entries a schedule can have.
+    let maxSegments: Int
+    /// Schedule entries start at a multiple of this many seconds from midnight.
+    let segmentSeconds: Int
+
+    init(_ limits: TherapyProfileEditLimits) {
+        func valueLimits(_ value: TherapyProfileEditLimits.ValueLimits) -> ValueLimits {
+            ValueLimits(min: value.bounds.lowerBound,
+                        max: value.bounds.upperBound,
+                        step: value.step,
+                        recommendedMin: value.recommended?.lowerBound,
+                        recommendedMax: value.recommended?.upperBound)
+        }
+        units = limits.unit.shortLocalizedUnitString(avoidLineBreaking: false)
+        maxBasal = limits.maximumBasalRatePerHour
+        basalRates = limits.basalRates
+        maxBasalSegments = limits.maximumBasalScheduleEntryCount
+        carbRatio = valueLimits(limits.carbRatio)
+        sensitivity = valueLimits(limits.sensitivity)
+        target = valueLimits(limits.target)
+        maxSegments = limits.maximumScheduleEntryCount
+        segmentSeconds = Int(limits.segmentInterval)
+    }
+
+    var dictionaryRepresentation: [String: Any] {
+        var rval: [String: Any] = [
+            "units": units,
+            "maxBasal": maxBasal,
+            "basalRates": basalRates,
+            "carbRatio": carbRatio.dictionaryRepresentation,
+            "sensitivity": sensitivity.dictionaryRepresentation,
+            "target": target.dictionaryRepresentation,
+            "maxSegments": maxSegments,
+            "segmentSeconds": segmentSeconds,
+        ]
+        rval["maxBasalSegments"] = maxBasalSegments
+        return rval
+    }
+}
+
+extension StoredSettings {
+    /// The profile set with one store entry per profile; the active profile's entry is the live settings.
+    var therapyProfileSet: TherapyProfileSet? {
+        guard let base = profileSet, let bloodGlucoseUnit, let live = base.store["Default"] else {
+            return nil
+        }
+        let unit = glucoseTargetRangeSchedule?.unit ?? bloodGlucoseUnit
+        let activeName = TherapyProfiles.activeName(activeProfileName)
+        var store: [String: ProfileSet.Profile] = [:]
+        for therapyProfile in resolvedTherapyProfiles {
+            guard let storeProfile = therapyProfile.nightscoutProfile(unit: unit) else {
+                return nil
+            }
+            store[therapyProfile.name] = storeProfile
+        }
+        store[activeName] = live
+        let editLimits = therapyProfileValidator?.editLimits(unit: unit)
+
+        return TherapyProfileSet(
+            profileSet: ProfileSet(
+                startDate: base.startDate,
+                units: base.units,
+                enteredBy: base.enteredBy,
+                defaultProfile: activeName,
+                store: store,
+                settings: base.settings,
+                syncIdentifier: base.syncIdentifier,
+                isAPNSProduction: base.isAPNSProduction),
+            profileEditLimits: editLimits.map { ProfileEditLimits($0) },
+            // Remote profile commands need remote notifications, a pump and a maximum basal rate.
+            remoteCommands: deviceToken != nil && editLimits != nil ? NightscoutService.remoteProfileCommands : nil,
+            scheduledSwitches: scheduledSwitches.map { TherapyProfileSet.ScheduledSwitch(id: $0.id, profile: $0.profileName, weekday: $0.weekday, time: Int($0.time), paused: $0.paused) },
+            scheduledSwitchesFingerprint: ScheduledProfileSwitches.fingerprint(scheduledSwitches))
+    }
+
+    /// The note of the Profile Switch treatment for a switch to these settings' active profile.
+    var profileSwitchNotes: String? {
+        switch activeProfileSwitchTrigger {
+        case .scheduled?:
+            return "Scheduled"
+        case .remote?:
+            return "Remote"
+        default:
+            return nil
+        }
+    }
+}
+
+extension HKUnit {
+    static func therapyProfileGlucoseUnit(fromNightscoutUnitString unitString: String) -> HKUnit? {
+        if unitString == HKUnit.millimolesPerLiter.shortLocalizedUnitString() ||
+            unitString == HKUnit.millimolesPerLiter.shortLocalizedUnitString(avoidLineBreaking: false) ||
+            unitString == "mmol/L" || unitString == "mmol"
+        {
+            return .millimolesPerLiter
+        }
+        if unitString == HKUnit.milligramsPerDeciliter.shortLocalizedUnitString() ||
+            unitString == HKUnit.milligramsPerDeciliter.shortLocalizedUnitString(avoidLineBreaking: false) ||
+            unitString == "mg/dL" || unitString == "mg/dl"
+        {
+            return .milligramsPerDeciliter
+        }
+        return nil
+    }
+}
