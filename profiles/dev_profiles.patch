+// MARK: - Upload
+
+extension NightscoutService {
+    /// The remote profile commands, listed in the uploaded profile set as `remoteCommands`.
+    static let remoteProfileCommands = TherapyProfileRemoteCommand.commandKeys
+
+    /// The profile sets that differ from the one uploaded before them, a Profile Switch treatment for each change of
+    /// the active profile (a rename is not one), and the content of the last profile set.
+    static func therapyProfileUploads(for stored: [StoredSettings], after lastUploaded: String?) -> (profileSets: [TherapyProfileSet], switches: [[String: Any]], lastUploaded: String?) {
+        var previous = lastUploaded
+        var previousActiveProfile = lastUploaded.flatMap(activeProfileName(inContent:))
+        var profileSets: [TherapyProfileSet] = []
+        var switches: [[String: Any]] = []
+        for settings in stored {
+            guard let profileSet = settings.therapyProfileSet else {
+                continue
+            }
+            let content = therapyProfileContent(profileSet)
+            guard content == nil || content != previous else {
+                continue
+            }
+            if let previousActiveProfile, previousActiveProfile != profileSet.defaultProfile, profileSet.store[previousActiveProfile] != nil {
+                switches.append(profileSwitchTreatment(timestamp: profileSet.startDate, profile: profileSet.defaultProfile, notes: settings.profileSwitchNotes, syncIdentifier: profileSet.syncIdentifier))
+            }
+            profileSets.append(profileSet)
+            previous = content
+            previousActiveProfile = profileSet.defaultProfile
+        }
+        return (profileSets, switches, previous)
+    }
+
+    static func therapyProfileContent(_ profileSet: TherapyProfileSet) -> String? {
+        var representation = profileSet.dictionaryRepresentation
+        representation["startDate"] = nil
+        representation["mills"] = nil
+        guard let data = try? JSONSerialization.data(withJSONObject: representation, options: .sortedKeys) else {
+            return nil
+        }
+        return String(data: data, encoding: .utf8)
+    }
+
+    private static func activeProfileName(inContent content: String) -> String? {
+        guard let json = try? JSONSerialization.jsonObject(with: Data(content.utf8)) as? [String: Any] else {
+            return nil
+        }
+        return json["defaultProfile"] as? String
+    }
+
+    /// A Profile Switch treatment, in effect until the next switch.
+    static func profileSwitchTreatment(timestamp: Date, profile: String, notes: String?, syncIdentifier: String) -> [String: Any] {
+        var rval = NightscoutTreatment(timestamp: timestamp, enteredBy: "Loop", notes: notes, eventType: .note, syncIdentifier: syncIdentifier).dictionaryRepresentation
+        rval["eventType"] = "Profile Switch"
+        rval["profile"] = profile
+        rval["duration"] = 0
+        return rval
+    }
+
+    private static let lastUploadedTherapyProfileSetKey = "com.loopkit.NightscoutServiceKit.LastUploadedTherapyProfileSet"
+
+    /// Uploads the profile sets that differ from the one uploaded before them, with a Profile Switch treatment for
+    /// each change of the active profile.
+    func uploadTherapyProfileSettings(_ stored: [StoredSettings], uploader: NightscoutClient, completion: @escaping (Result<Bool, Error>) -> Void) {
+        let defaults = UserDefaults.standard
+        let site = uploader.siteURL.absoluteString + "\n"
+        let lastUploaded = defaults.string(forKey: Self.lastUploadedTherapyProfileSetKey).flatMap { $0.hasPrefix(site) ? String($0.dropFirst(site.count)) : nil }
+        let (changed, switches, previous) = Self.therapyProfileUploads(for: stored, after: lastUploaded)
+        guard !changed.isEmpty else {
+            completion(.success(true))
+            return
+        }
+        Task {
+            do {
+                try await uploadTherapyProfileSets(changed, switches: switches, uploader: uploader)
+                defaults.set(previous.map { site + $0 }, forKey: Self.lastUploadedTherapyProfileSetKey)
+                completion(.success(true))
+            } catch {
+                completion(.failure(error))
+            }
+        }
+    }
+
+    func uploadTherapyProfileSets(_ profileSets: [TherapyProfileSet], switches: [[String: Any]], uploader: NightscoutClient) async throws {
+        if !switches.isEmpty {
+            try await uploader.postTherapyProfileJSON(switches, path: "/api/v1/treatments")
+        }
+        try await uploader.postTherapyProfileJSON(profileSets.map(\.dictionaryRepresentation), path: "/api/v1/profile")
+    }
+}
+
+extension NightscoutClient {
+    func postTherapyProfileJSON(_ json: [Any], path: String) async throws {
+        _ = try await therapyProfileRequest(method: "POST", path: path, json: json)
+    }
+
+    func getTherapyProfileJSON(path: String) async throws -> Any {
+        let data = try await therapyProfileRequest(method: "GET", path: path, json: nil)
+        return try JSONSerialization.jsonObject(with: data)
+    }
+
+    private func therapyProfileRequest(method: String, path: String, json: Any?) async throws -> Data {
+        guard var components = URLComponents(url: siteURL, resolvingAgainstBaseURL: false) else {
+            throw NightscoutError.missingConfiguration
+        }
+        components.path = path
+        guard let url = components.url else {
+            throw NightscoutError.missingConfiguration
+        }
+        var request = URLRequest(url: url)
+        request.httpMethod = method
+        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        if let apiSecret, !apiSecret.isEmpty {
+            let hash = Insecure.SHA1.hash(data: Data(apiSecret.utf8)).map { String(format: "%02x", $0) }.joined()
+            request.setValue(hash, forHTTPHeaderField: "api-secret")
+        }
+        if let json {
+            request.httpBody = try JSONSerialization.data(withJSONObject: json)
+        }
+        let (data, response) = try await URLSession.shared.data(for: request)
+        guard let httpResponse = response as? HTTPURLResponse else {
+            throw NightscoutError.invalidResponse(reason: "Response is not HTTPURLResponse")
+        }
+        guard httpResponse.statusCode == 200 else {
+            throw NightscoutError.invalidResponse(reason: "HTTP \(httpResponse.statusCode): \(String(data: data, encoding: .utf8) ?? "")")
+        }
+        return data
+    }
+}
