+extension NightscoutService {
+    /// The current Nightscout profile document as therapy settings with every profile that can be imported,
+    /// including a document another uploader, such as Trio, wrote.
+    public func fetchImportedTherapySettings(completion: @escaping (Result<ImportedTherapySettings, Error>) -> Void) {
+        guard let siteURL, let apiSecret else {
+            completion(.failure(NightscoutServiceError.missingCredentials))
+            return
+        }
+        let client = NightscoutClient(siteURL: siteURL, apiSecret: apiSecret)
+        Task {
+            do {
+                let raw = try await client.getTherapyProfileJSON(path: "/api/v1/profile/current")
+                // Loop's own settings, when the document has them, come from NightscoutKit.
+                let settings: NightscoutKit.LoopSettings? = await withCheckedContinuation { continuation in
+                    client.fetchCurrentProfile { result in
+                        continuation.resume(returning: try? result.get().settings)
+                    }
+                }
+                guard let rawValue = raw as? [String: Any],
+                      let document = TherapyProfileDocument(rawValue: rawValue, settings: settings),
+                      let imported = document.importedTherapySettings
+                else {
+                    completion(.failure(NightscoutServiceError.incompatibleTherapySettings))
+                    return
+                }
+                completion(.success(imported))
+            } catch {
+                completion(.failure(error))
+            }
+        }
+    }
+}
+
+/// A Nightscout profile document, read without NightscoutKit so documents without Loop's settings are read too.
+struct TherapyProfileDocument {
+    /// Some uploaders, such as Trio, store the Default profile under this key.
+    static let lowercaseDefaultProfileKey = "default"
+
+    let startDate: Date
+    let units: String
+    let defaultProfile: String
+    let store: [String: ProfileSet.Profile]
+    let settings: NightscoutKit.LoopSettings?
+    let scheduledSwitches: [TherapyProfileSet.ScheduledSwitch]?
+
+    init?(rawValue: [String: Any], settings: NightscoutKit.LoopSettings?) {
+        guard
+            let startDateString = rawValue["startDate"] as? String,
+            let startDate = Self.date(from: startDateString),
+            let units = rawValue["units"] as? String,
+            let defaultProfile = rawValue["defaultProfile"] as? String,
+            let storeRaw = rawValue["store"] as? [String: [String: Any]]
+        else {
+            return nil
+        }
+        self.startDate = startDate
+        self.units = units
+        self.defaultProfile = defaultProfile
+        self.store = storeRaw.compactMapValues(Self.profile(rawValue:))
+        self.settings = settings
+        self.scheduledSwitches = (rawValue["scheduledSwitches"] as? [[String: Any]])?.compactMap { TherapyProfileSet.ScheduledSwitch(rawValue: $0) }
+    }
+
+    private static func date(from string: String) -> Date? {
+        let formatter = ISO8601DateFormatter()
+        formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        if let date = formatter.date(from: string) {
+            return date
+        }
+        formatter.formatOptions = [.withInternetDateTime]
+        return formatter.date(from: string)
+    }
+
+    private static func profile(rawValue: [String: Any]) -> ProfileSet.Profile? {
+        guard
+            let timeZoneString = rawValue["timezone"] as? String,
+            let timeZone = timeZone(from: timeZoneString),
+            let sensitivity = (rawValue["sens"] as? [[String: Any]]).flatMap(scheduleItems),
+            let carbratio = (rawValue["carbratio"] as? [[String: Any]]).flatMap(scheduleItems),
+            let basal = (rawValue["basal"] as? [[String: Any]]).flatMap(scheduleItems),
+            let targetLow = (rawValue["target_low"] as? [[String: Any]]).flatMap(scheduleItems),
+            let targetHigh = (rawValue["target_high"] as? [[String: Any]]).flatMap(scheduleItems)
+        else {
+            return nil
+        }
+        let dia = (rawValue["dia"] as? Double) ?? Double(rawValue["dia"] as? String ?? "") ?? 6
+        return ProfileSet.Profile(timezone: timeZone,
+                                  dia: .hours(dia),
+                                  sensitivity: sensitivity,
+                                  carbratio: carbratio,
+                                  basal: basal,
+                                  targetLow: targetLow,
+                                  targetHigh: targetHigh,
+                                  units: rawValue["units"] as? String ?? "")
+    }
+
+    /// Loop writes fixed offsets as "ETC/GMT-1"; other uploaders write time zone identifiers.
+    private static func timeZone(from string: String) -> TimeZone? {
+        if string.uppercased().hasPrefix("ETC/GMT"), let hours = Int(string.dropFirst("ETC/GMT".count)) {
+            return TimeZone(secondsFromGMT: -hours * 3600)
+        }
+        return TimeZone(identifier: string)
+    }
+
+    private static func scheduleItems(_ raw: [[String: Any]]) -> [ProfileSet.ScheduleItem]? {
+        var items: [ProfileSet.ScheduleItem] = []
+        for entry in raw {
+            guard let value = (entry["value"] as? Double) ?? Double(entry["value"] as? String ?? "") else {
+                return nil
+            }
+            if let seconds = (entry["timeAsSeconds"] as? Double) ?? Double(entry["timeAsSeconds"] as? String ?? "") {
+                items.append(ProfileSet.ScheduleItem(offset: seconds, value: value))
+            } else if let time = entry["time"] as? String {
+                let parts = time.split(separator: ":")
+                guard parts.count == 2, let hours = Int(parts[0]), let minutes = Int(parts[1]) else {
+                    return nil
+                }
+                items.append(ProfileSet.ScheduleItem(offset: .hours(Double(hours)) + .minutes(Double(minutes)), value: value))
+            } else {
+                return nil
+            }
+        }
+        return items
+    }
+
+    /// The live schedules are the active profile's (`defaultProfile`, as Default when its name is invalid), and every
+    /// store profile that passes the checks that need no pump is a therapy profile.
+    var importedTherapySettings: ImportedTherapySettings? {
+        guard let settingsGlucoseUnit = HKUnit.therapyProfileGlucoseUnit(fromNightscoutUnitString: units) else {
+            return nil
+        }
+
+        var namedStore: [String: ProfileSet.Profile] = [:]
+        for (key, profile) in store {
+            namedStore[profileName(forStoreKey: key)] = profile
+        }
+        let requestedActiveName = profileName(forStoreKey: defaultProfile)
+        let liveName = namedStore[requestedActiveName] != nil ? requestedActiveName : TherapyProfile.defaultName
+        guard let profile = namedStore[liveName] else {
+            return nil
+        }
+
+        var activeName = liveName
+        var skippedProfiles: [ImportedTherapySettings.SkippedProfile] = []
+        if liveName != requestedActiveName, !requestedActiveName.isEmpty {
+            skippedProfiles.append(.init(name: requestedActiveName, reason: "The active profile is not in the profile document, so the Default profile's values are imported as the therapy settings"))
+        }
+        do {
+            try TherapyProfileValidator.validateName(liveName, isDefault: liveName == TherapyProfile.defaultName, existingNames: [])
+        } catch {
+            activeName = TherapyProfile.defaultName
+            let reason = namedStore[activeName] != nil
+                ? "%1$@; its values are imported as the Default profile and replace the stored Default profile"
+                : "%1$@; its values are imported as the Default profile"
+            skippedProfiles.append(.init(name: liveName, reason: String(format: reason, error.localizedDescription)))
+        }
+
+        // A glucose safety limit outside its guardrail, such as one left in mg/dL after the units changed, is dropped.
+        let suspendThreshold = settings?.minimumBGGuard
+            .map { GlucoseThreshold(unit: settingsGlucoseUnit, value: $0) }
+            .flatMap { Guardrail.suspendThreshold.absoluteBounds.contains($0.quantity) ? $0 : nil }
+
+        // The active profile becomes the live settings, so it passes the same checks as every other profile or
+        // nothing is imported.
+        guard let activeProfile = try? TherapyProfile(name: activeName, nightscoutProfile: profile, defaultUnit: settingsGlucoseUnit),
+              (try? TherapyProfileValidator.validateValues(of: activeProfile, suspendThreshold: suspendThreshold)) != nil
+        else {
+            return nil
+        }
+        var profiles = [activeProfile]
+        let names = namedStore.keys.sorted { lhs, rhs in
+            if (lhs == TherapyProfile.defaultName) != (rhs == TherapyProfile.defaultName) {
+                return lhs == TherapyProfile.defaultName
+            }
+            return lhs.localizedStandardCompare(rhs) == .orderedAscending
+        }
+        for name in names where name != activeName && name != liveName {
+            guard let entry = namedStore[name] else { continue }
+            // Default is always kept, so it counts against the limit even when it is not stored.
+            let reserved = profiles.contains(where: \.isDefault) || name == TherapyProfile.defaultName ? 0 : 1
+            guard profiles.count + reserved < TherapyProfileValidator.maximumProfileCount else {
+                skippedProfiles.append(.init(name: name, reason: String(format: "Loop keeps at most %1$d profiles", TherapyProfileValidator.maximumProfileCount)))
+                continue
+            }
+            do {
+                try TherapyProfileValidator.validateName(name, isDefault: name == TherapyProfile.defaultName, existingNames: profiles.map(\.name))
+                let storedProfile = try TherapyProfile(name: name, nightscoutProfile: entry, defaultUnit: settingsGlucoseUnit)
+                try TherapyProfileValidator.validateValues(of: storedProfile, suspendThreshold: suspendThreshold)
+                profiles.append(storedProfile)
+            } catch {
+                var reason = error.localizedDescription
+                if name == TherapyProfile.defaultName {
+                    reason += " " + String(format: "%1$@ gets the values of %2$@.", TherapyProfile.defaultName, activeName)
+                }
+                skippedProfiles.append(.init(name: name, reason: reason))
+            }
+        }
+        let therapyProfiles = TherapyProfiles.resolved(profiles, activeProfileName: activeName, live: activeProfile)
+        let (scheduledSwitches, skippedScheduledSwitches) = importedScheduledSwitches(profileNames: therapyProfiles.map(\.name))
+
+        let correctionRangeOverrides = settings?.preMealTargetRange.map {
+            CorrectionRangeOverrides(preMeal: GlucoseRange(minValue: $0.lowerBound, maxValue: $0.upperBound, unit: settingsGlucoseUnit), workout: nil)
+        }
+
+        let therapySettings = TherapySettings(
+            glucoseTargetRangeSchedule: activeProfile.glucoseTargetRangeSchedule,
+            correctionRangeOverrides: correctionRangeOverrides,
+            overridePresets: settings?.overridePresets.compactMap { $0.loopOverride(for: settingsGlucoseUnit) },
+            maximumBasalRatePerHour: settings?.maximumBasalRatePerHour,
+            maximumBolus: settings?.maximumBolus,
+            suspendThreshold: suspendThreshold,
+            insulinSensitivitySchedule: activeProfile.insulinSensitivitySchedule,
+            carbRatioSchedule: activeProfile.carbRatioSchedule,
+            basalRateSchedule: activeProfile.basalRateSchedule,
+            defaultRapidActingModel: nil, // Not stored in NS yet
+            therapyProfiles: therapyProfiles.count > 1 ? therapyProfiles : nil,
+            activeProfileName: activeName == TherapyProfile.defaultName ? nil : activeName,
+            scheduledSwitches: scheduledSwitches)
+
+        return ImportedTherapySettings(therapySettings: therapySettings, date: startDate, skippedProfiles: skippedProfiles, skippedScheduledSwitches: skippedScheduledSwitches)
+    }
+
+    /// The scheduled switches, all of them or none: a week with some starts left out would keep profiles active at
+    /// times the document does not.
+    private func importedScheduledSwitches(profileNames: [String]) -> (entries: [ScheduledProfileSwitch]?, skipped: [ImportedTherapySettings.SkippedProfile]) {
+        guard let documentSwitches = scheduledSwitches, !documentSwitches.isEmpty else {
+            return (nil, [])
+        }
+        let entries = documentSwitches.map {
+            ScheduledProfileSwitch(id: $0.id, profileName: profileName(forStoreKey: $0.profile), weekday: $0.weekday, time: TimeInterval($0.time), paused: $0.paused)
+        }
+        let missingNames = Set(entries.map(\.profileName)).subtracting(profileNames)
+        if !missingNames.isEmpty {
+            return (nil, entries.map { entry in
+                let reason = missingNames.contains(entry.profileName)
+                    ? String(format: "The profile %1$@ is not imported", entry.profileName)
+                    : "Scheduled switches are imported only when every profile they start is imported"
+                return .init(name: entry.localizedDescription, reason: reason)
+            })
+        }
+        do {
+            try ScheduledProfileSwitches.validate(entries, profileNames: profileNames)
+            return (entries, [])
+        } catch {
+            return (nil, entries.map { .init(name: $0.localizedDescription, reason: error.localizedDescription) })
+        }
+    }
+
+    private func profileName(forStoreKey key: String) -> String {
+        guard key == Self.lowercaseDefaultProfileKey, store[TherapyProfile.defaultName] == nil else {
+            return key
+        }
+        return TherapyProfile.defaultName
+    }
+}
+
+extension TherapyProfile {
+    /// A profile from a Nightscout `store` entry, with glucose values in the entry's units or else `defaultUnit`.
+    init(name: String, nightscoutProfile profile: ProfileSet.Profile, defaultUnit: HKUnit) throws {
+        let unit = profile.units.flatMap { HKUnit.therapyProfileGlucoseUnit(fromNightscoutUnitString: $0) } ?? defaultUnit
+        guard profile.targetLow.map(\.offset) == profile.targetHigh.map(\.offset) else {
+            throw TherapyProfileError.invalidSchedule("The correction range has different start times for its lower and upper values")
+        }
+        try TherapyProfileValidator.validateScheduleShape(startTimes: profile.basal.map(\.offset), settingName: "Basal Rates")
+        try TherapyProfileValidator.validateScheduleShape(startTimes: profile.carbratio.map(\.offset), settingName: "Carb Ratios")
+        try TherapyProfileValidator.validateScheduleShape(startTimes: profile.sensitivity.map(\.offset), settingName: "Insulin Sensitivities")
+        try TherapyProfileValidator.validateScheduleShape(startTimes: profile.targetLow.map(\.offset), settingName: "Correction Range")
+        guard let targets = GlucoseRangeSchedule(unit: unit,
+                                                 dailyItems: zip(profile.targetLow, profile.targetHigh).map { RepeatingScheduleValue(startTime: $0.offset, value: DoubleRange(minValue: $0.value, maxValue: $1.value)) },
+                                                 timeZone: profile.timeZone),
+              let carbRatios = CarbRatioSchedule(unit: .gram(), dailyItems: profile.carbratio.map { RepeatingScheduleValue(startTime: $0.offset, value: $0.value) }, timeZone: profile.timeZone),
+              let basalRates = BasalRateSchedule(dailyItems: profile.basal.map { RepeatingScheduleValue(startTime: $0.offset, value: $0.value) }, timeZone: profile.timeZone),
+              let sensitivities = InsulinSensitivitySchedule(unit: unit, dailyItems: profile.sensitivity.map { RepeatingScheduleValue(startTime: $0.offset, value: $0.value) }, timeZone: profile.timeZone)
+        else {
+            throw TherapyProfileError.invalidSchedule("A schedule could not be read")
+        }
+        self.init(name: name,
+                  glucoseTargetRangeSchedule: targets,
+                  carbRatioSchedule: carbRatios,
+                  basalRateSchedule: basalRates,
+                  insulinSensitivitySchedule: sensitivities)
+    }
+}
+
+// MARK: - Remote commands
+
+/// Remote therapy profile commands. They are handled apart from `RemoteCommandSourceV1` with the same steps:
+/// decode, skip duplicates, check expiration and OTP, act, reply through the return push, and post a Nightscout note
+/// on any error.
+extension NightscoutService: TherapyProfileRemoteCommandReceiver {
+    private static let therapyProfileLog = OSLog(category: "RemoteTherapyProfile")
+    private static let recentTherapyProfileCommands = RecentTherapyProfileCommands()
+
+    public func isTherapyProfileCommand(_ notification: [String: AnyObject]) -> Bool {
+        TherapyProfileRemoteCommand.commandKeys.contains { notification[$0] != nil }
+    }
+
+    public func therapyProfileCommandWasReceived(_ notification: [String: AnyObject]) async {
+        var command: TherapyProfileRemoteCommand?
+        do {
+            let decoded = try TherapyProfileRemoteCommand(notification: notification)
+            command = decoded
+            guard await Self.recentTherapyProfileCommands.isNew(decoded.id) else {
+                // Duplicate notifications are expected after app is force killed
+                return
+            }
+            do {
+                try decoded.validate(otpManager: otpManager)
+            } catch {
+                await TherapyProfileRemoteResponse.send(to: decoded.envelope.returnNotificationInfo(), command: decoded, failure: error)
+                throw error
+            }
+            do {
+                try await perform(decoded)
+            } catch {
+                await TherapyProfileRemoteResponse.send(to: decoded.envelope.returnNotificationInfo(), command: decoded, failure: error)
+                throw error
+            }
+            await TherapyProfileRemoteResponse.send(to: decoded.envelope.returnNotificationInfo(), command: decoded, failure: nil)
+        } catch {
+            os_log("Remote profile command: %{public}@. Error: %{public}@", log: Self.therapyProfileLog, type: .error, String(describing: notification), String(describing: error))
+            try? await uploadTherapyProfileCommandNote(command: command, error: error, notification: notification)
+        }
+    }
+
+    private func perform(_ command: TherapyProfileRemoteCommand) async throws {
+        guard let delegate = serviceDelegate as? TherapyProfileRemoteActionDelegate else {
+            throw TherapyProfileRemoteCommandError.unavailable
+        }
+        switch command.kind {
+        case .switchProfile(let switchCommand):
+            try await delegate.switchRemoteTherapyProfile(name: switchCommand.name, expectedFingerprint: switchCommand.fingerprint)
+        case .saveProfile(let saveCommand):
+            if saveCommand.originalName != nil && saveCommand.baseFingerprint == nil {
+                throw RemoteProfileCommandError.missingFingerprint
+            }
+            let profile = try TherapyProfile(name: saveCommand.name, compactValues: saveCommand.values, timeZone: .current)
+            try await delegate.saveRemoteTherapyProfile(profile, originalName: saveCommand.originalName, expectedFingerprint: saveCommand.baseFingerprint)
+        case .deleteProfile(let deleteCommand):
+            try await delegate.deleteRemoteTherapyProfile(name: deleteCommand.name, expectedFingerprint: deleteCommand.fingerprint)
+        case .saveScheduledSwitches(let scheduledCommand):
+            guard let baseFingerprint = scheduledCommand.baseFingerprint else {
+                throw RemoteProfileCommandError.missingScheduledSwitchesFingerprint
+            }
+            try await delegate.saveRemoteScheduledProfileSwitches(scheduledCommand.entries, expectedFingerprint: baseFingerprint)
+        }
+    }
+
+    private func uploadTherapyProfileCommandNote(command: TherapyProfileRemoteCommand?, error: Error, notification: [String: AnyObject]) async throws {
+        guard let siteURL, let apiSecret else {
+            throw NightscoutServiceError.missingCredentials
+        }
+        let notificationJSON = try JSONSerialization.data(withJSONObject: notification)
+        let notificationJSONString = String(data: notificationJSON, encoding: .utf8) ?? ""
+        let treatment = NightscoutTreatment(
+            timestamp: Date(),
+            enteredBy: command?.description ?? "Loop Remote Action Error",
+            notes: """
+            \(command?.failureMessage(for: error) ?? error.localizedDescription)
+            \(notificationJSONString)
+            """,
+            eventType: .note
+        )
+        let uploader = NightscoutClient(siteURL: siteURL, apiSecret: apiSecret)
+        try await withCheckedThrowingContinuation { (continuation: CheckedContinuation<Void, Error>) in
+            uploader.upload([treatment]) { result in
+                switch result {
+                case .success:
+                    continuation.resume()
+                case .failure(let error):
+                    continuation.resume(throwing: error)
+                }
+            }
+        }
+    }
+}
+
+/// The fields every remote command carries.
+struct TherapyProfileRemoteEnvelope: Decodable {
+    let remoteAddress: String
+    let expiration: Date
+    let sentAt: Date?
+    let otp: String?
+    let enteredBy: String?
+    let encryptedReturnNotification: String?
+
+    enum CodingKeys: String, CodingKey {
+        case remoteAddress = "remote-address"
+        case expiration = "expiration"
+        case sentAt = "sent-at"
+        case otp = "otp"
+        case enteredBy = "entered-by"
+        case encryptedReturnNotification = "encrypted_return_notification"
+    }
+
+    func returnNotificationInfo() -> ReturnNotificationInfo? {
+        guard let encryptedReturnNotification, let otp, let messenger = OTPSecureMessenger(otpCode: otp) else {
+            return nil
+        }
+        return try? messenger.decrypt(base64EncodedString: encryptedReturnNotification)
+    }
+}
+
+/// A remote therapy profile command. `expiration` is required: decoding fails without it.
+struct TherapyProfileRemoteCommand {
+    struct Switch: Decodable {
+        let name: String
+        /// The fingerprint of the profile the caregiver reviewed.
+        let fingerprint: String
+
+        enum CodingKeys: String, CodingKey {
+            case name = "profile-switch"
+            case fingerprint = "profile-switch-fingerprint"
+        }
+    }
+
+    struct Save: Decodable {
+        let name: String
+        /// The profile to update; nil creates a profile.
+        let originalName: String?
+        /// The fingerprint of the original profile the caregiver edited.
+        let baseFingerprint: String?
+        let values: CompactProfileValues
+
+        enum CodingKeys: String, CodingKey {
+            case name = "profile-save"
+            case originalName = "profile-save-original-name"
+            case baseFingerprint = "profile-save-base-fingerprint"
+            case values = "profile-save-values"
+        }
+    }
+
+    struct Delete: Decodable {
+        let name: String
+        /// The fingerprint of the profile the caregiver reviewed.
+        let fingerprint: String
+
+        enum CodingKeys: String, CodingKey {
+            case name = "profile-delete"
+            case fingerprint = "profile-delete-fingerprint"
+        }
+    }
+
+    struct ScheduledSwitchesSave: Decodable {
+        /// The whole list that replaces the phone's scheduled switches.
+        let entries: [ScheduledProfileSwitch]
+        /// The fingerprint of the list the caregiver edited.
+        let baseFingerprint: String?
+
+        enum CodingKeys: String, CodingKey {
+            case entries = "profile-scheduled-switches-save"
+            case baseFingerprint = "profile-scheduled-switches-base-fingerprint"
+        }
+    }
+
+    enum Kind {
+        case switchProfile(Switch)
+        case saveProfile(Save)
+        case deleteProfile(Delete)
+        case saveScheduledSwitches(ScheduledSwitchesSave)
+    }
+
+    static let commandKeys = ["profile-switch", "profile-save", "profile-delete", "profile-scheduled-switches-save"]
+
+    let kind: Kind
+    let envelope: TherapyProfileRemoteEnvelope
+
+    init(notification: [String: AnyObject]) throws {
+        let data = try JSONSerialization.data(withJSONObject: notification)
+        let decoder = JSONDecoder()
+        decoder.dateDecodingStrategy = .formatted(DateFormatter.iso8601DateDecoder)
+        envelope = try decoder.decode(TherapyProfileRemoteEnvelope.self, from: data)
+        if notification["profile-switch"] != nil {
+            kind = .switchProfile(try decoder.decode(Switch.self, from: data))
+        } else if notification["profile-save"] != nil {
+            kind = .saveProfile(try decoder.decode(Save.self, from: data))
+        } else if notification["profile-delete"] != nil {
+            kind = .deleteProfile(try decoder.decode(Delete.self, from: data))
+        } else if notification["profile-scheduled-switches-save"] != nil {
+            kind = .saveScheduledSwitches(try decoder.decode(ScheduledSwitchesSave.self, from: data))
+        } else {
+            throw TherapyProfileRemoteCommandError.unknownCommand
+        }
+    }
+
+    /// There is no unique identifier, so the sent date is used when there is one.
+    var id: String {
+        envelope.sentAt.map { "\($0.timeIntervalSince1970)" } ?? UUID().uuidString
+    }
+
+    /// Expiration first, so an expired command does not use up its OTP.
+    func validate(otpManager: OTPManager, now: Date = Date()) throws {
+        guard now <= envelope.expiration else {
+            throw TherapyProfileRemoteCommandError.expired
+        }
+        guard let otp = envelope.otp else {
+            throw TherapyProfileRemoteCommandError.missingOTP
+        }
+        try otpManager.validatePassword(password: otp, deliveryDate: envelope.sentAt)
+    }
+
+    var commandType: String {
+        switch kind {
+        case .switchProfile:
+            return "profile_switch"
+        case .saveProfile:
+            return "profile_save"
+        case .deleteProfile:
+            return "profile_delete"
+        case .saveScheduledSwitches:
+            return "profile_scheduled_switches_save"
+        }
+    }
+
+    private var actionName: String {
+        switch kind {
+        case .switchProfile:
+            return "Profile Switch"
+        case .saveProfile:
+            return "Profile Save"
+        case .deleteProfile:
+            return "Profile Delete"
+        case .saveScheduledSwitches:
+            return "Scheduled Switches Save"
+        }
+    }
+
+    /// The name of the profile the command targets; for a rename, the new name.
+    private var profileName: String? {
+        switch kind {
+        case .switchProfile(let command):
+            return command.name
+        case .saveProfile(let command):
+            return command.name
+        case .deleteProfile(let command):
+            return command.name
+        case .saveScheduledSwitches:
+            return nil
+        }
+    }
+
+    private var outcome: String {
+        switch kind {
+        case .switchProfile:
+            return "activated"
+        case .saveProfile, .saveScheduledSwitches:
+            return "saved"
+        case .deleteProfile:
+            return "deleted"
+        }
+    }
+
+    var description: String {
+        "\(actionName) \(profileName ?? "")"
+    }
+
+    var successMessage: String {
+        guard let profileName else {
+            return "Scheduled switches saved"
+        }
+        return "Profile '\(profileName)' \(outcome)"
+    }
+
+    func failureMessage(for error: Error) -> String {
+        guard let profileName else {
+            return "Scheduled switches not saved: \(error.localizedDescription)"
+        }
+        return "Profile '\(profileName)' not \(outcome): \(error.localizedDescription)"
+    }
+
+    /// The reply's `result` code: `activated`, `saved`, `deleted`, `conflict`, `not_found` or `rejected`.
+    func result(failure: Error?) -> String {
+        switch failure {
+        case nil:
+            return outcome
+        case TherapyProfileError.conflict?, ScheduledProfileSwitchError.conflict?:
+            return "conflict"
+        case TherapyProfileError.notFound(_)?:
+            return "not_found"
+        default:
+            return "rejected"
+        }
+    }
+}
+
+private actor RecentTherapyProfileCommands {
+    private var ids = [String]()
+
+    func isNew(_ id: String) -> Bool {
+        if ids.contains(id) {
+            return false
+        }
+        ids.append(id)
+        return true
+    }
+}
+
+/// The return push to the caregiver, in the format of `RemoteNotificationResponseManager` plus a `result` code.
+enum TherapyProfileRemoteResponse {
+    private static let log = OSLog(category: "RemoteTherapyProfile")
+
+    struct Payload: Encodable {
+        let aps: APS
+        let commandStatus: String
+        let commandType: String
+        /// A code the caller can match on, independent of the alert text's language.
+        let result: String
+        let timestamp: TimeInterval
+
+        enum CodingKeys: String, CodingKey {
+            case aps
+            case commandStatus = "command_status"
+            case commandType = "command_type"
+            case result
+            case timestamp
+        }
+    }
+
+    struct APS: Encodable {
+        let alert: Alert
+        let sound: String = "default"
+    }
+
+    struct Alert: Encodable {
+        let title: String
+        let body: String
+    }
+
+    static func payload(command: TherapyProfileRemoteCommand, failure: Error?, date: Date = Date()) -> Payload {
+        Payload(
+            aps: APS(alert: Alert(title: failure == nil ? "Command Successful" : "Command Failed",
+                                  body: failure.map { command.failureMessage(for: $0) } ?? command.successMessage)),
+            commandStatus: failure == nil ? "success" : "failed",
+            commandType: command.commandType,
+            result: command.result(failure: failure),
+            timestamp: date.timeIntervalSince1970
+        )
+    }
+
+    static func send(to returnInfo: ReturnNotificationInfo?, command: TherapyProfileRemoteCommand, failure: Error?) async {
+        guard let returnInfo, !returnInfo.deviceToken.isEmpty else {
+            os_log("No return notification info, response not sent", log: log, type: .info)
+            return
+        }
+        guard let jwt = APNSJWTManager.shared.getOrGenerateJWT(keyId: returnInfo.keyId, teamId: returnInfo.teamId, apnsKey: returnInfo.apnsKey) else {
+            os_log("Failed to generate JWT for response notification", log: log, type: .error)
+            return
+        }
+        let host = returnInfo.productionEnvironment ? "api.push.apple.com" : "api.sandbox.push.apple.com"
+        guard let url = URL(string: "https://\(host)/3/device/\(returnInfo.deviceToken)") else {
+            os_log("Failed to construct APNs URL", log: log, type: .error)
+            return
+        }
+
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.setValue("bearer \(jwt)", forHTTPHeaderField: "authorization")
+        request.setValue("application/json", forHTTPHeaderField: "content-type")
+        request.setValue("10", forHTTPHeaderField: "apns-priority")
+        request.setValue("0", forHTTPHeaderField: "apns-expiration")
+        request.setValue(returnInfo.bundleId, forHTTPHeaderField: "apns-topic")
+        request.setValue("alert", forHTTPHeaderField: "apns-push-type")
+
+        do {
+            request.httpBody = try JSONEncoder().encode(payload(command: command, failure: failure))
+            let (_, response) = try await URLSession.shared.data(for: request)
+            if let httpResponse = response as? HTTPURLResponse, httpResponse.statusCode != 200 {
+                os_log("Failed to send response notification: %d", log: log, type: .error, httpResponse.statusCode)
+            }
+        } catch {
+            os_log("Error sending response notification: %{public}@", log: log, type: .error, error.localizedDescription)
+        }
+    }
+}
+
+/// The values of a `profile-save` command: `[seconds, value]` entries, and `[seconds, low, high]` for the target.
+struct CompactProfileValues: Codable, Equatable {
+    let units: String
+    let basal: [[Double]]
+    let carbratio: [[Double]]
+    let sens: [[Double]]
+    let target: [[Double]]
+}
+
+/// Reasons a remote profile command is refused before the phone looks at its profiles.
+enum TherapyProfileRemoteCommandError: LocalizedError {
+    case unknownCommand
+    case unavailable
+    case expired
+    case missingOTP
+
+    var errorDescription: String? {
+        switch self {
+        case .unknownCommand:
+            return "Unknown profile command"
+        case .unavailable:
+            return "Profiles are not available"
+        case .expired:
+            return "Expired"
+        case .missingOTP:
+            return "Missing OTP"
+        }
+    }
+}
+
+// MARK: - Profile switch in the device status
+
+extension TherapyProfileRemoteCommand {
+    /// Listed in `loop.testingDetails.remoteCommands` of each uploaded device status. LoopFollow releases without
+    /// profile editing offer remote switching when they find it there; newer LoopFollow reads the profile document.
+    static let deviceStatusSwitchCommand = "profile-switch"
+}
+
+extension DeviceStatus {
+    /// Adds `command` to `loop.testingDetails.remoteCommands`, keeping commands already listed there.
+    /// `LoopStatus` is copied field by field; when the copy differs from the original in anything but
+    /// `testingDetails`, the original is returned unchanged so no uploaded data is lost.
+    func addingRemoteCommand(_ command: String) -> DeviceStatus {
+        guard let loopStatus else {
+            return self
+        }
+        var testingDetails = loopStatus.testingDetails ?? [:]
+        let remoteCommands = testingDetails["remoteCommands"] as? [String] ?? []
+        guard !remoteCommands.contains(command) else {
+            return self
+        }
+        testingDetails["remoteCommands"] = remoteCommands + [command]
+
+        let updated = DeviceStatus(
+            device: device,
+            timestamp: timestamp,
+            pumpStatus: pumpStatus,
+            uploaderStatus: uploaderStatus,
+            loopStatus: loopStatus.replacingTestingDetails(testingDetails),
+            radioAdapter: radioAdapter,
+            overrideStatus: overrideStatus,
+            identifier: identifier)
+
+        guard updated.dictionaryRepresentationWithoutTestingDetails == dictionaryRepresentationWithoutTestingDetails else {
+            return self
+        }
+        return updated
+    }
+
+    var dictionaryRepresentationWithoutTestingDetails: NSDictionary {
+        var representation = dictionaryRepresentation
+        if var loop = representation["loop"] as? [String: Any] {
+            loop["testingDetails"] = nil
+            representation["loop"] = loop
+        }
+        return NSDictionary(dictionary: representation)
+    }
+}
+
+extension LoopStatus {
+    func replacingTestingDetails(_ testingDetails: [String: Any]) -> LoopStatus {
+        return LoopStatus(
+            name: name,
+            version: version,
+            timestamp: timestamp,
+            iob: iob,
+            cob: cob,
+            predicted: predicted,
+            automaticDoseRecommendation: automaticDoseRecommendation,
+            recommendedBolus: recommendedBolus,
+            enacted: enacted,
+            rileylinks: rileylinks,
+            failureReason: failureReason,
+            currentCorrectionRange: currentCorrectionRange,
+            forecastError: forecastError,
+            testingDetails: testingDetails
+        )
+    }
+}
