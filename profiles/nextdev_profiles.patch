+                                 dismissButton: .default(Text("Got it!")))
+                }
+            }
+            
+            if isAddingNewProfile {
+                DarkenedOverlay()
+                
+                NewProfileEditor(
+                    isPresented: $isAddingNewProfile,
+                    newProfileName: newProfileName,
+                    viewModel: viewModel
+                )
+                .transition(AnyTransition.move(edge: .bottom).combined(with: .opacity).animation(.default))
+            }
+        }
+    }
