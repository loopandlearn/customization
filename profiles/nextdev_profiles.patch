diff --git a/NightscoutService/NightscoutServiceKitTests/RemoteProfileSwitchTestCase.swift b/NightscoutService/NightscoutServiceKitTests/RemoteProfileSwitchTestCase.swift
new file mode 100644
index 0000000..369fb3e
--- /dev/null
+++ b/NightscoutService/NightscoutServiceKitTests/RemoteProfileSwitchTestCase.swift
@@ -0,0 +1,135 @@
+//
+//  RemoteProfileSwitchTestCase.swift
+//  NightscoutServiceKitTests
+//
+
+import XCTest
+import LoopKit
+import NightscoutKit
+@testable import NightscoutServiceKit
+
+final class RemoteProfileSwitchTestCase: XCTestCase {
+
+    func testParseProfileSwitchCommand_ValidPayload_Succeeds() throws {
+        let notification: [String: Any] = [
+            "profile-switch": "Sport",
+            "profile-switch-fingerprint": "fec4f066b5a54ecd",
+            "remote-address": "LoopFollow",
+            "sent-at": "2023-02-25T20:46:35.778Z",
+            "expiration": "2023-02-25T20:51:35.778Z",
+            "otp": "123456"
+        ]
+
+        let command = try ProfileSwitchCommand(dictionary: notification)
+
+        XCTAssertEqual(command.profileName, "Sport")
+        XCTAssertEqual(command.fingerprint, "fec4f066b5a54ecd")
+        XCTAssertEqual(command.expiration, ISO8601DateFormatter.fractional.date(from: "2023-02-25T20:51:35.778Z"))
+        XCTAssertEqual(command.sentAt, ISO8601DateFormatter.fractional.date(from: "2023-02-25T20:46:35.778Z"))
+    }
+
+    func testParseProfileSwitchCommand_MissingExpiration_Fails() {
+        let notification: [String: Any] = [
+            "profile-switch": "Sport",
+            "profile-switch-fingerprint": "fec4f066b5a54ecd",
+            "remote-address": "LoopFollow",
+            "otp": "123456"
+        ]
+
+        XCTAssertThrowsError(try ProfileSwitchCommand(dictionary: notification))
+    }
+
+    func testValidate_Expired_FailsBeforeOTP() throws {
+        let command = try ProfileSwitchCommand(dictionary: [
+            "profile-switch": "Sport",
+            "profile-switch-fingerprint": "fec4f066b5a54ecd",
+            "remote-address": "LoopFollow",
+            "expiration": "2023-02-25T20:51:35.778Z",
+            "otp": "123456"
+        ])
+
+        XCTAssertThrowsError(try command.validate(otpManager: OTPManager(secretStore: MockSecretStore()))) { error in
+            guard case RemoteProfileSwitchError.expired = error else {
+                return XCTFail("Expected expired, got \(error)")
+            }
+        }
+    }
+
+    func testFingerprint_MatchesFollowerVector() {
+        let profile = ProfileSet.Profile(
+            timezone: TimeZone(secondsFromGMT: 3600)!,
+            dia: .hours(6),
+            sensitivity: items([(0, 45)]),
+            carbratio: items([(0, 10)]),
+            basal: items([(0, 0.85), (21600, 1.1)]),
+            targetLow: items([(0, 100)]),
+            targetHigh: items([(0, 110)]),
+            units: "mg/dL")
+
+        XCTAssertEqual(profile.remoteFingerprint, "fec4f066b5a54ecd")
+    }
+
+    func testAddingRemoteCommand_KeepsListedCommandsAndOtherFields() {
+        let status = deviceStatus(testingDetails: ["remoteCommands": ["carbs-delete"], "other": 1])
+
+        let updated = status.addingRemoteCommand(ProfileSwitchCommand.commandKey)
+
+        XCTAssertEqual(updated.loopStatus?.testingDetails?["remoteCommands"] as? [String], ["carbs-delete", "profile-switch"])
+        XCTAssertEqual(updated.loopStatus?.testingDetails?["other"] as? Int, 1)
+        XCTAssertEqual(updated.dictionaryRepresentationWithoutTestingDetails, status.dictionaryRepresentationWithoutTestingDetails)
+    }
+
+    func testAddingRemoteCommand_WithoutTestingDetails_AddsList() {
+        let updated = deviceStatus(testingDetails: nil).addingRemoteCommand(ProfileSwitchCommand.commandKey)
+
+        XCTAssertEqual(updated.loopStatus?.testingDetails?["remoteCommands"] as? [String], ["profile-switch"])
+    }
+
+    func testResponsePayload_UsesProfileSwitchCommandType() throws {
+        let data = try JSONEncoder().encode(ProfileSwitchResponse.payload(success: false, message: "Command failed: Profile 'Sport' not activated: Pod not connected"))
+        let json = try XCTUnwrap(JSONSerialization.jsonObject(with: data) as? [String: Any])
+
+        XCTAssertEqual(json["command_type"] as? String, "profile_switch")
+        XCTAssertEqual(json["command_status"] as? String, "failed")
+        let alert = try XCTUnwrap((json["aps"] as? [String: Any])?["alert"] as? [String: Any])
+        XCTAssertEqual(alert["body"] as? String, "Command failed: Profile 'Sport' not activated: Pod not connected")
+    }
+
+    private func items(_ values: [(TimeInterval, Double)]) -> [ProfileSet.ScheduleItem] {
+        values.map { ProfileSet.ScheduleItem(offset: $0.0, value: $0.1) }
+    }
+
+    private func deviceStatus(testingDetails: [String: Any]?) -> DeviceStatus {
+        let date = Date(timeIntervalSince1970: 1_700_000_000)
+        let loopStatus = LoopStatus(
+            name: "Loop",
+            version: "3.0",
+            timestamp: date,
+            iob: IOBStatus(timestamp: date, iob: 1.5),
+            recommendedBolus: 0.4,
+            failureReason: "failure",
+            testingDetails: testingDetails)
+        return DeviceStatus(device: "loop://iPhone", timestamp: date, uploaderStatus: UploaderStatus(name: "iPhone", timestamp: date, battery: 50), loopStatus: loopStatus, identifier: "id")
+    }
+}
+
+private final class MockSecretStore: OTPSecretStore {
+    private var key: String? = "2KBHFASYM6DKWFGW"
+    private var keyName: String? = "Mock"
+    private var accepted = [String]()
+
+    func tokenSecretKey() -> String? { key }
+    func tokenSecretKeyName() -> String? { keyName }
+    func setTokenSecretKey(_ key: String?) throws { self.key = key }
+    func setTokenSecretKeyName(_ name: String?) throws { self.keyName = name }
+    func recentAcceptedPasswords() -> [String] { accepted }
+    func setRecentAcceptedPasswords(_ passwords: [String]) throws { accepted = passwords }
+}
+
+private extension ISO8601DateFormatter {
+    static let fractional: ISO8601DateFormatter = {
+        let formatter = ISO8601DateFormatter()
+        formatter.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
+        return formatter
+    }()
+}
