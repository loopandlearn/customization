@@ -0,0 +1,318 @@
+//
+//  NightscoutService+RemoteProfileSwitch.swift
+//  NightscoutServiceKit
+//
+
+import Foundation
+import LoopKit
+import NightscoutKit
+import OSLog
+
+/// Remote profile switch commands. They are handled apart from `RemoteCommandSourceV1` with the same steps:
+/// decode, skip duplicates, check expiration and OTP, act, reply through the return push, and post a
+/// Nightscout note on any error.
+extension NightscoutService: RemoteProfileSwitchReceiver {
+
+    private static let profileSwitchLog = OSLog(category: "RemoteProfileSwitch")
+    private static let recentProfileSwitches = RecentProfileSwitches()
+
+    public func isProfileSwitch(_ notification: [String: AnyObject]) -> Bool {
+        return notification[ProfileSwitchCommand.commandKey] != nil
+    }
+
+    public func profileSwitchWasReceived(_ notification: [String: AnyObject]) async {
+        do {
+            let command = try ProfileSwitchCommand(dictionary: notification)
+            guard await Self.recentProfileSwitches.isNew(command) else {
+                // Duplicate notifications are expected after app is force killed
+                return
+            }
+            try command.validate(otpManager: otpManager)
+            try await activateProfile(command)
+        } catch {
+            os_log("Remote profile switch: %{public}@. Error: %{public}@", log: Self.profileSwitchLog, type: .error, String(describing: notification), String(describing: error))
+            try? await uploadProfileSwitchNote(error: error, notification: notification)
+        }
+    }
+
+    private func activateProfile(_ command: ProfileSwitchCommand) async throws {
+        let returnInfo = command.returnNotificationInfo()
+        do {
+            guard let profileDelegate = serviceDelegate as? RemoteProfileActionDelegate else {
+                throw RemoteProfileSwitchError.unavailable
+            }
+            try await profileDelegate.activateRemoteProfile(name: command.profileName) { correctionRange, carbRatio, basalRate, insulinSensitivity in
+                let savedProfile = SavedProfile(name: command.profileName, correctionRange: correctionRange, carbRatioSchedule: carbRatio, basalRateSchedule: basalRate, insulinSensitivitySchedule: insulinSensitivity)
+                guard savedProfile.matches(fingerprint: command.fingerprint) else {
+                    throw RemoteProfileSwitchError.profileChanged
+                }
+            }
+        } catch {
+            let failure = RemoteProfileSwitchError.notActivated(command.profileName, error)
+            await ProfileSwitchResponse.send(to: returnInfo, success: false, message: "Command failed: \(failure.localizedDescription)")
+            throw failure
+        }
+        await ProfileSwitchResponse.send(to: returnInfo, success: true, message: "Profile '\(command.profileName)' activated")
+    }
+
+    private func uploadProfileSwitchNote(error: Error, notification: [String: AnyObject]) async throws {
+        guard let siteURL, let apiSecret else {
+            throw NightscoutServiceError.missingCredentials
+        }
+        let notificationJSON = try JSONSerialization.data(withJSONObject: notification)
+        let notificationJSONString = String(data: notificationJSON, encoding: .utf8) ?? ""
+
+        let treatment = NightscoutTreatment(
+            timestamp: Date(),
+            enteredBy: LocalizedString("Profile Switch", comment: "The remote action name for Profile Switch"),
+            notes: """
+            \(error.localizedDescription)
+            \(notificationJSONString)
+            """,
+            eventType: .note
+        )
+
+        let uploader = NightscoutClient(siteURL: siteURL, apiSecret: apiSecret)
+        return try await withCheckedThrowingContinuation { continuation in
+            uploader.upload([treatment]) { result in
+                switch result {
+                case .success:
+                    continuation.resume()
+                case .failure(let error):
+                    continuation.resume(throwing: error)
+                }
+            }
+        }
+    }
+}
+
+/// A profile switch push. `expiration` is required: decoding fails without it.
+struct ProfileSwitchCommand: Codable {
+
+    /// Listed in the uploaded `remoteCommands` so followers know this build accepts the command.
+    static let commandKey = "profile-switch"
+
+    let profileName: String
+    let fingerprint: String
+    let remoteAddress: String
+    let expiration: Date
+    let sentAt: Date?
+    let otp: String?
+    let enteredBy: String?
+    let encryptedReturnNotification: String?
+
+    enum CodingKeys: String, CodingKey {
+        case profileName = "profile-switch"
+        case fingerprint = "profile-switch-fingerprint"
+        case remoteAddress = "remote-address"
+        case expiration = "expiration"
+        case sentAt = "sent-at"
+        case otp = "otp"
+        case enteredBy = "entered-by"
+        case encryptedReturnNotification = "encrypted_return_notification"
+    }
+
+    init(dictionary: [String: Any]) throws {
+        let data = try JSONSerialization.data(withJSONObject: dictionary)
+        let jsonDecoder = JSONDecoder()
+        jsonDecoder.dateDecodingStrategy = .formatted(DateFormatter.iso8601DateDecoder)
+        self = try jsonDecoder.decode(Self.self, from: data)
+    }
+
+    /// Expiration first, so an expired command does not use up its OTP.
+    func validate(otpManager: OTPManager, now: Date = Date()) throws {
+        guard now <= expiration else {
+            throw RemoteProfileSwitchError.expired
+        }
+        guard let otp else {
+            throw RemoteProfileSwitchError.missingOTP
+        }
+        try otpManager.validatePassword(password: otp, deliveryDate: sentAt)
+    }
+
+    func returnNotificationInfo() -> ReturnNotificationInfo? {
+        guard let encryptedReturnNotification, let otp, let messenger = OTPSecureMessenger(otpCode: otp) else {
+            return nil
+        }
+        return try? messenger.decrypt(base64EncodedString: encryptedReturnNotification)
+    }
+}
+
+private actor RecentProfileSwitches {
+    private var sentDates = [Date]()
+
+    /// Commands without `sent-at` cannot be matched and always count as new.
+    func isNew(_ command: ProfileSwitchCommand) -> Bool {
+        guard let sentAt = command.sentAt else {
+            return true
+        }
+        if sentDates.contains(sentAt) {
+            return false
+        }
+        sentDates.append(sentAt)
+        return true
+    }
+}
+
+/// The return push to the follower, in the format of `RemoteNotificationResponseManager` with
+/// `command_type` `profile_switch`. Followers match the reply by the profile name in the body.
+enum ProfileSwitchResponse {
+    private static let log = OSLog(category: "RemoteProfileSwitch")
+
+    struct Payload: Encodable {
+        let aps: APS
+        let commandStatus: String
+        let commandType: String
+        let timestamp: TimeInterval
+
+        enum CodingKeys: String, CodingKey {
+            case aps
+            case commandStatus = "command_status"
+            case commandType = "command_type"
+            case timestamp
+        }
+    }
+
+    struct APS: Encodable {
+        let alert: Alert
+        let sound: String = "default"
+    }
+
+    struct Alert: Encodable {
+        let title: String
+        let body: String
+    }
+
+    static func payload(success: Bool, message: String) -> Payload {
+        return Payload(
+            aps: APS(alert: Alert(title: success ? "Command Successful" : "Command Failed", body: message)),
+            commandStatus: success ? "success" : "failed",
+            commandType: "profile_switch",
+            timestamp: Date().timeIntervalSince1970
+        )
+    }
+
+    static func send(to returnInfo: ReturnNotificationInfo?, success: Bool, message: String) async {
+        guard let returnInfo, !returnInfo.deviceToken.isEmpty else {
+            os_log("No return notification info, response not sent", log: log, type: .info)
+            return
+        }
+        guard let jwt = APNSJWTManager.shared.getOrGenerateJWT(keyId: returnInfo.keyId, teamId: returnInfo.teamId, apnsKey: returnInfo.apnsKey) else {
+            os_log("Failed to generate JWT for response notification", log: log, type: .error)
+            return
+        }
+        let host = returnInfo.productionEnvironment ? "api.push.apple.com" : "api.sandbox.push.apple.com"
+        guard let url = URL(string: "https://\(host)/3/device/\(returnInfo.deviceToken)") else {
+            os_log("Failed to construct APNs URL", log: log, type: .error)
+            return
+        }
+
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.setValue("bearer \(jwt)", forHTTPHeaderField: "authorization")
+        request.setValue("application/json", forHTTPHeaderField: "content-type")
+        request.setValue("10", forHTTPHeaderField: "apns-priority")
+        request.setValue("0", forHTTPHeaderField: "apns-expiration")
+        request.setValue(returnInfo.bundleId, forHTTPHeaderField: "apns-topic")
+        request.setValue("alert", forHTTPHeaderField: "apns-push-type")
+
+        do {
+            request.httpBody = try JSONEncoder().encode(payload(success: success, message: message))
+            let (_, response) = try await URLSession.shared.data(for: request)
+            if let httpResponse = response as? HTTPURLResponse, httpResponse.statusCode != 200 {
+                os_log("Failed to send response notification: %d", log: log, type: .error, httpResponse.statusCode)
+            }
+        } catch {
+            os_log("Error sending response notification: %{public}@", log: log, type: .error, error.localizedDescription)
+        }
+    }
+}
+
+enum RemoteProfileSwitchError: LocalizedError {
+    case profileChanged
+    case unavailable
+    case expired
+    case missingOTP
+    case notActivated(String, Error)
+
+    /// Followers read the profile name from this text to match the reply to their command.
+    var errorDescription: String? {
+        switch self {
+        case .profileChanged:
+            return LocalizedString("It changed after it was uploaded. Review it again and resend.", comment: "Remote profile switch error description: profile differs from the previewed one.")
+        case .unavailable:
+            return LocalizedString("Profile switching is not available", comment: "Remote profile switch error description: host cannot switch profiles.")
+        case .expired:
+            return LocalizedString("Expired", comment: "Remote command error description: expired.")
+        case .missingOTP:
+            return LocalizedString("Missing OTP", comment: "Remote command error description: Missing OTP.")
+        case .notActivated(let name, let error):
+            return String(format: LocalizedString("Profile '%1$@' not activated: %2$@", comment: "Remote profile switch failure. (1: profile name, 2: reason)"), name, error.localizedDescription)
+        }
+    }
+}
+
+extension DeviceStatus {
+    /// Adds `command` to `loop.testingDetails.remoteCommands`, keeping commands already listed there.
+    /// `LoopStatus` is copied field by field; when the copy differs from the original in anything but
+    /// `testingDetails`, the original is returned unchanged so no uploaded data is lost.
+    func addingRemoteCommand(_ command: String) -> DeviceStatus {
+        guard let loopStatus else {
+            return self
+        }
+        var testingDetails = loopStatus.testingDetails ?? [:]
+        let remoteCommands = testingDetails["remoteCommands"] as? [String] ?? []
+        guard !remoteCommands.contains(command) else {
+            return self
+        }
+        testingDetails["remoteCommands"] = remoteCommands + [command]
+
+        let updated = DeviceStatus(
+            device: device,
+            timestamp: timestamp,
+            pumpStatus: pumpStatus,
+            uploaderStatus: uploaderStatus,
+            loopStatus: loopStatus.replacingTestingDetails(testingDetails),
+            radioAdapter: radioAdapter,
+            overrideStatus: overrideStatus,
+            identifier: identifier)
+
+        guard updated.dictionaryRepresentationWithoutTestingDetails == dictionaryRepresentationWithoutTestingDetails else {
+            return self
+        }
+        return updated
+    }
+
+    var dictionaryRepresentationWithoutTestingDetails: NSDictionary {
+        var representation = dictionaryRepresentation
+        if var loop = representation["loop"] as? [String: Any] {
+            loop["testingDetails"] = nil
+            representation["loop"] = loop
+        }
+        return NSDictionary(dictionary: representation)
+    }
+}
+
+extension LoopStatus {
+    func replacingTestingDetails(_ testingDetails: [String: Any]) -> LoopStatus {
+        return LoopStatus(
+            name: name,
+            version: version,
+            timestamp: timestamp,
+            iob: iob,
+            cob: cob,
+            predicted: predicted,
+            automaticDoseRecommendation: automaticDoseRecommendation,
+            recommendedBolus: recommendedBolus,
+            bolusCalculation: bolusCalculation,
+            enacted: enacted,
+            rileylinks: rileylinks,
+            failureReason: failureReason,
+            failureCode: failureCode,
+            currentCorrectionRange: currentCorrectionRange,
+            forecastError: forecastError,
+            testingDetails: testingDetails,
+            algorithmExperiments: algorithmExperiments
+        )
+    }
+}
