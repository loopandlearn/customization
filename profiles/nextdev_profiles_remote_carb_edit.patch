+//  NightscoutServiceKit
+//
+
+import Foundation
+
+public struct ProfileSwitchAction: Codable {
+
+    public let name: String
+    public let fingerprint: String
+
+    public init(name: String, fingerprint: String) {
+        self.name = name
+        self.fingerprint = fingerprint
+    }
+}
