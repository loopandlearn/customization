index 0000000..588ded1
--- /dev/null
+++ b/NightscoutService/NightscoutServiceKit/Extensions/SavedProfile.swift
@@ -0,0 +1,104 @@
+//
+//  SavedProfile.swift
+//  NightscoutServiceKit
+//
+
+import CryptoKit
+import Foundation
+import LoopAlgorithm
+import LoopKit
+import NightscoutKit
+
+/// A profile saved with the Profiles settings screen, read from the file it was saved to.
+struct SavedProfile: Decodable {
+    let name: String
+    let correctionRange: GlucoseRangeSchedule
+    let carbRatioSchedule: CarbRatioSchedule
+    let basalRateSchedule: BasalRateSchedule
+    let insulinSensitivitySchedule: InsulinSensitivitySchedule
+
+    private static var directory: URL {
+        FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0].appendingPathComponent("LoopProfile")
+    }
+
+    static func loadAll() -> [SavedProfile] {
+        let files = (try? FileManager.default.contentsOfDirectory(at: directory, includingPropertiesForKeys: nil)) ?? []
+        return files
+            .filter { $0.pathExtension == "json" }
+            .compactMap { try? Data(contentsOf: $0) }
+            .compactMap { try? JSONDecoder().decode(SavedProfile.self, from: $0) }
+    }
+
+    /// Saved profiles keyed by name, in the form they are uploaded to the Nightscout profile store.
+    static func nightscoutStore(unit: LoopUnit) -> [String: ProfileSet.Profile] {
+        var store: [String: ProfileSet.Profile] = [:]
+        // Nightscout cannot store keys starting with "$"; "Default" holds the live settings.
+        for savedProfile in loadAll() where !savedProfile.name.hasPrefix("$") && savedProfile.name != "Default" {
+            store[savedProfile.name] = savedProfile.nightscoutProfile(unit: unit)
+        }
+        return store
+    }
+
+    /// True when this profile uploads with this fingerprint, in either glucose unit.
+    func matches(fingerprint: String) -> Bool {
+        [LoopUnit.milligramsPerDeciliter, .millimolesPerLiter].contains {
+            nightscoutProfile(unit: $0)?.remoteFingerprint == fingerprint
+        }
+    }
+
+    func nightscoutProfile(unit: LoopUnit) -> ProfileSet.Profile? {
+        guard let correctionRange = correctionRange.schedule(for: unit),
+              let insulinSensitivity = insulinSensitivitySchedule.schedule(for: unit)
+        else {
+            return nil
+        }
+        return ProfileSet.Profile(
+            timezone: basalRateSchedule.timeZone,
+            dia: .hours(6),
+            sensitivity: insulinSensitivity.items.map { ProfileSet.ScheduleItem(offset: $0.startTime, value: $0.value) },
+            carbratio: carbRatioSchedule.items.map { ProfileSet.ScheduleItem(offset: $0.startTime, value: $0.value) },
+            basal: basalRateSchedule.items.map { ProfileSet.ScheduleItem(offset: $0.startTime, value: $0.value) },
+            targetLow: correctionRange.items.map { ProfileSet.ScheduleItem(offset: $0.startTime, value: $0.value.minValue) },
+            targetHigh: correctionRange.items.map { ProfileSet.ScheduleItem(offset: $0.startTime, value: $0.value.maxValue) },
+            units: unit.shortLocalizedUnitString(avoidLineBreaking: false))
+    }
+}
+
+extension ProfileSet.Profile {
+    /// Followers compute the same value from the uploaded profile and send it with a switch command,
+    /// so Loop only activates the values the follower previewed.
+    /// Format: `basal=<seconds>:<value>,...;carbratio=...;sens=...;target_low=...;target_high=...`
+    /// with values to three decimals, hashed with SHA-256, first 16 hex characters.
+    var remoteFingerprint: String {
+        func items(_ schedule: [ProfileSet.ScheduleItem]) -> String {
+            schedule.map { "\(Int($0.offset)):" + String(format: "%.3f", $0.value) }.joined(separator: ",")
+        }
+        let canonical = [
+            "basal=" + items(basal),
+            "carbratio=" + items(carbratio),
+            "sens=" + items(sensitivity),
+            "target_low=" + items(targetLow),
+            "target_high=" + items(targetHigh),
+        ].joined(separator: ";")
+        let digest = SHA256.hash(data: Data(canonical.utf8))
+        return String(digest.map { String(format: "%02x", $0) }.joined().prefix(16))
+    }
+}
+
+enum RemoteProfileSwitchError: LocalizedError {
+    case profileChanged
+    case unavailable
+    case notActivated(String, Error)
+
+    /// Followers read the profile name from this text to match the reply to their command.
+    var errorDescription: String? {
+        switch self {
+        case .profileChanged:
+            return LocalizedString("It changed after it was uploaded. Review it again and resend.", comment: "Remote profile switch error description: profile differs from the previewed one.")
+        case .unavailable:
+            return LocalizedString("Profile switching is not available", comment: "Remote profile switch error description: host cannot switch profiles.")
+        case .notActivated(let name, let error):
+            return String(format: LocalizedString("Profile '%1$@' not activated: %2$@", comment: "Remote profile switch failure. (1: profile name, 2: reason)"), name, error.localizedDescription)
+        }
+    }
+}
